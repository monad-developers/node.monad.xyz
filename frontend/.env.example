# The WebSocket endpoint for events
NEXT_PUBLIC_EVENTS_WS_URL="wss://<SERVER_ADDR>:<SERVER_PORT>"

# BlockVision Pro API key for Monad mainnet contract metadata lookups
# Get your API key from https://docs.blockvision.org/
BLOCKVISION_API_KEY="your-api-key-here"

# Set to "true" to show the maintenance banner at the top of the page (default: hidden)
NEXT_PUBLIC_SHOW_MAINTENANCE_BANNER="false"
